{
  "name": "harmonic-analyzer-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive simulator of Michelson's harmonic analyzer, driven by the exported CAD model",
  "license": "MIT",
  "scripts": {
    "fetch-model": "node scripts/fetch-model.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --test scripts/cloudflare-deployments.test.mjs scripts/deployment-transport.test.mjs scripts/optimize-model.test.mjs",
    "test:deployments": "node --test scripts/cloudflare-deployments.test.mjs",
    "prebuild:deploy": "npm run test:deployments",
    "build:deploy": "node scripts/deployment.mjs build",
    "deploy": "node scripts/deployment.mjs deploy",
    "deploy:preview": "node scripts/deployment.mjs preview",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "meshoptimizer": "0.22.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "wrangler": "4.148.0"
  }
}

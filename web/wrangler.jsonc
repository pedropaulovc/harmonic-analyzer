{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "harmonicanalyzer-com-prod",
  "account_id": "6b2522c874d4613dc2bf47bd2ce521a2",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-08",
  "keep_vars": true,
  "workers_dev": true,
  "routes": [
    { "pattern": "harmonicanalyzer.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": false
  }
}

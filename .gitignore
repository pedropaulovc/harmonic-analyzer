# CAD/KCL generated files
cad/*.stl
cad/*.png
cad/*.jpg
cad/*.txt
cad/output.*
# DIMENSIONS.md is an on-demand render of cad/config/dimensions.yaml (the source
# of truth) — never committed; a versioned copy kept drifting. Render locally
# with `python cad/scripts/gen_dimensions.py` if you want the readable view.
cad/DIMENSIONS.md
cad/project.toml
cad/**/project.toml
cad/**/thumbnail.png

# Generated CAD artifacts — the build scripts are the source of truth, so
# none of these are versioned as living documents. Rebuild with
# `doit` (dodo.py); snapshot binaries only at tagged releases (see README).
cad/out/sldprt/
cad/out/sldasm/
cad/out/png/
cad/out/demo/
cad/out/*.mp4

# doit build-graph hash database (DOIT_CONFIG dep_file, json backend)
cad/out/.doit.db*

# Downloaded release bundles (gh release download); large binaries, never
# committed — the release on GitHub is the snapshot.
download/

# Generated verify.py reports + doit gate stamps (rebuild with `doit build`)
cad/out/reports/

# Offline-render cache (regenerable: cad/scripts/export_models.py;
# the assembly STL alone is >100 MB — over GitHub's file limit)
cad/out/stl/
cad/out/step/
cad/out/boxes/
# Changed-parts diff renders (regenerable: comparisons/tools/render_diff.py)
cad/out/diff/
# Regenerable STEP/STL/PNG exports written to cad/out/ root
cad/out/*.step
cad/out/*.stl
cad/out/*.png
# Parts BOM (regenerable build output: build_harmonic_analyzer_assembly.py;
# write-only, no repo consumer — keeping it tracked dirtied the tree on every
# build and blocked doit release's clean-tree preflight)
cad/out/harmonic-analyzer-bom.csv

# Mesa OSMesa software-GL DLL fetched on demand for headless VTK rendering
# (comparisons/tools/osmesa_win.py; ~55 MB, regenerable from pal1000/mesa-dist-win)
comparisons/tools/.osmesa-cache/

# Parity-test scratch (comparisons/tools/parity_check.py)
comparisons/.parity_sw/

# SolidworksMCP runtime state (agent memory, checkpoint scripts, RAG cache) and
# the generated API docs index — machine-local, regenerated by the MCP server
.solidworks_mcp/
.generated/docs-index/


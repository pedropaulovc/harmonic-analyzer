// Summing Lever for Harmonic Analyzer
// Material: Cast iron (as seen in reference photo)
// Purpose: First-class lever that sums multiple harmonic inputs from springs
// and transfers the combined motion to the recording mechanism




@settings(defaultLengthUnit = in, kclVersion = 1.0)

// ============================================================================
// INPUT PARAMETERS (from user sketches)
// ============================================================================

// Overall dimensions
leverLength = 20.0 // Total horizontal length (estimated from proportions)
baseThickness = 0.125 // 1/8" extrusion thickness


// Left paddle section (input side with multiple spring holes)
paddleWidth = 3.0 // Width of paddle section
paddleLength = 5.0 // Length along lever arm
paddleHoleCount = 20 // Total mounting holes (4x5 pattern from photo)
paddleHoleRows = 4 // Rows of holes
paddleHoleCols = 5 // Columns of holes
paddleHoleDiam = 0.125 // Spring mounting hole diameter


// Center fulcrum section
fulcrumPosition = 10.0 // Distance from left end to fulcrum center
fulcrumSlotWidth = 0.5 // Width of mounting slot
fulcrumSlotLength = 1.0 // Length of mounting slot


// Right counter-weight section
counterWidth = 2.0 // Width of counter-weight arm
counterHoleDiam = 1.0 // Diameter of spring hole (from sketch)


// Transition curves (from sketch)
smallRadius = 0.333 // 1/3" radius for tight curves
largeRadius = 2.0 // 2" radius for gradual transitions


// Edge fillets
edgeFillet = 0.0625 // 1/16" fillet on main edges (to be added in Phase 6)


// ============================================================================
// CALCULATED PARAMETERS
// ============================================================================

// Paddle hole spacing (columns along X/length, rows along Y/width)
paddleHoleSpacingX = paddleLength * 0.8 / (paddleHoleCols - 1) // Spacing between columns
paddleHoleSpacingY = paddleWidth * 0.8 / (paddleHoleRows - 1)  // Spacing between rows
paddleHoleStartX = paddleLength * 0.1  // First column position along length
paddleHoleStartY = -paddleWidth * 0.4  // First row position along width

// Right arm dimensions
counterArmLength = leverLength - fulcrumPosition - 2.0
counterHolePosition = fulcrumPosition + counterArmLength - 1.0

// ============================================================================
// ASSERTIONS - Validate design constraints
// ============================================================================


assert(leverLength, isGreaterThan = paddleLength + 5.0, error = "Lever too short for paddle and counter sections")
assert(fulcrumPosition, isGreaterThan = paddleLength * 0.5, error = "Fulcrum too close to paddle end")
assert(fulcrumPosition, isLessThan = leverLength - counterArmLength, error = "Fulcrum position leaves insufficient counter-arm length")
assert(paddleWidth, isGreaterThan = paddleHoleDiam * paddleHoleCols * 1.5, error = "Paddle too narrow for hole pattern")
assert(counterHoleDiam, isLessThan = counterWidth * 0.8, error = "Counter hole too large for arm width")

// ============================================================================
// PHASE 1-2: BASIC OUTLINE WITH MOUNTING HOLES
// ============================================================================
// Creating simplified geometry for initial review
// Will add organic curves in Phase 4

// Create base paddle profile (centered at origin)
paddleProfile = startSketchOn(XY)
  |> startProfile(at = [0, -paddleWidth / 2])
  |> line(end = [paddleLength, 0], tag = $paddleBottom)
  |> line(end = [0, paddleWidth])
  |> line(end = [-paddleLength, 0])
  |> close()

  // Create mounting hole pattern (4 rows x 5 columns = 20 holes)
// Start with one hole, pattern along X (columns), then pattern that along Y (rows)
mountingHoles = startSketchOn(XY)
  |> circle(
       center = [paddleHoleStartX, paddleHoleStartY],
       radius = paddleHoleDiam / 2,
     )
  |> patternLinear2d(axis = X, instances = paddleHoleCols, distance = paddleHoleSpacingX)
  |> patternLinear2d(axis = Y, instances = paddleHoleRows, distance = paddleHoleSpacingY)

// Subtract holes in 2D before extruding (best practice - more reliable than 3D subtract)
leverOutline = paddleProfile
  |> subtract2d(tool = mountingHoles)
  |> extrude(length = baseThickness)

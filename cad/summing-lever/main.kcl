// Simple Rectangle Sketch




@settings(defaultLengthUnit = mm, kclVersion = 1.0)

// Dimensions
width = 3
height = 9
depth = 0.1
cylinderRadius = 0.5
ribThickness = 0.2
ribHeight = 0.5

// Create rectangle sketch and extrude to 3D solid
solid = startSketchOn(XY)
  |> rectangle(width = width, height = height, center = [0, 0])
  |> extrude(length = depth)

// Add cylinder along the long edge (perpendicular to rectangle)
cylinder = startSketchOn(XZ)
  |> circle(center = [width / 2, depth / 2], radius = cylinderRadius)
  |> extrude(length = height, symmetric = true)

  // Add 3 ribs parallel to short edges using linear pattern
// Ribs extend beyond rectangle to cover cylinder on both sides
ribWidth = width + 2 * cylinderRadius
ribs = startSketchOn(XY)
  |> startProfile(at = [
       -(width / 2 + cylinderRadius),
       -3 - (ribThickness / 2)
     ])
  |> line(end = [ribWidth, 0])
  |> line(end = [0, ribThickness])
  |> line(end = [-ribWidth, 0])
  |> close()
  |> extrude(length = depth + ribHeight)
  |> patternLinear3d(axis = [0, 1, 0], instances = 3, distance = 3)

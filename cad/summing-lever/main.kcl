// Simple Rectangle Sketch




@settings(defaultLengthUnit = mm, kclVersion = 1.0)

// Dimensions
width = 3
height = 9
depth = 0.1
cylinderRadius = 0.5
ribThickness = 0.2
ribHeight = 0.5

// Rib pattern parameters
ribCount = 3
ribSpacing = 3

// Triangle parameters
triangleBaseLength = width / 3
triangleHeight = 4

// Calculated parameters
cylinderDiameter = 2 * cylinderRadius
ribOffset = (ribCount - 1) * ribSpacing / 2

// Create rectangle sketch and extrude to 3D solid
solid = startSketchOn(XY)
  |> rectangle(width = width, height = height, center = [0, 0])
  |> extrude(length = depth)

// Add cylinder along the long edge (perpendicular to rectangle)
cylinder = startSketchOn(XZ)
  |> circle(center = [width / 2, depth / 2], radius = cylinderRadius)
  |> extrude(length = height, symmetric = true)

ribs = startSketchOn(XZ)
  |> startProfile(at = [width / 2, depth / 2 - cylinderRadius])
  |> line(end = [0, cylinderDiameter])
  |> line(end = [-width, -cylinderRadius])
  |> close()
  |> extrude(length = ribThickness, symmetric = true)
  |> patternLinear3d(axis = [0, 1, 0], instances = ribCount, distance = ribSpacing)
  |> translate(x = 0, y = -ribOffset, z = 0)

// Triangle in XY plane with base at cylinder edge
triangle = startSketchOn(XY)
  |> startProfile(at = [width / 2, -triangleBaseLength / 2])
  |> line(end = [0, triangleBaseLength])
  |> line(end = [
       triangleHeight,
       -triangleBaseLength / 2
     ])
  |> close()
  |> extrude(length = depth)

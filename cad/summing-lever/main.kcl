// Harmonic Analyzer Summing Lever Components
// - Coefficients Plate (rectangular plate with holes)
// - Summation Plate (triangular extension)
// - Summation Anchor (cylinder at triangle tip)




@settings(defaultLengthUnit = in, kclVersion = 1.0)

// Dimensions
coefficientsPlateWidth = 1.75
coefficientsPlateLength = 6
plateThickness = 0.2
cylinderRadius = 0.5
ribThickness = 0.2
ribHeight = 0.5

// Rib parameters
// Middle rib is at center, edge ribs at plate ends

// Summation plate parameters
summationPlateBaseLength = coefficientsPlateLength / 2
summationPlateHeight = 3
summationPlateCurvature = 0.5

// Hole pattern parameters
holeCount = 20
holeRadius = 0.01
holeMargin = 0.2 // 1/5" margin from plate edges
holeSpanLength = coefficientsPlateLength - 2 * holeMargin
holeSpacing = holeSpanLength / (holeCount - 1)

// Calculated parameters
cylinderDiameter = 2 * cylinderRadius
cylinderCenterX = coefficientsPlateWidth / 2
cylinderCenterZ = plateThickness / 2
holeOffset = coefficientsPlateLength / 2 - holeMargin

// Create hole pattern for 2D subtraction
// Position holes at left edge with margin = plateThickness from edge
holeXPosition = -coefficientsPlateWidth / 2 + holeRadius + plateThickness
holes = startSketchOn(XY)
  |> circle(center = [holeXPosition, -holeOffset], radius = holeRadius)
  |> patternLinear2d(axis = [0, 1], instances = holeCount, distance = holeSpacing)

// Coefficients plate: rectangular plate with holes for spring connections
coefficientsPlate = startSketchOn(XY)
  |> rectangle(width = coefficientsPlateWidth, height = coefficientsPlateLength, center = [0, 0])
  |> subtract2d(tool = holes)
  |> extrude(length = plateThickness)

// Add cylinder along the long edge (perpendicular to rectangle)
cylinder = startSketchOn(XZ)
  |> circle(center = [cylinderCenterX, cylinderCenterZ], radius = cylinderRadius)
  |> extrude(length = coefficientsPlateLength, symmetric = true)
  |> appearance(color = "#FF0000", metalness = 60, roughness = 20)

// Middle rib at center
middleRib = startSketchOn(XZ)
  |> startProfile(at = [
       cylinderCenterX,
       cylinderCenterZ - cylinderRadius
     ])
  |> line(end = [0, cylinderDiameter])
  |> line(end = [
       -coefficientsPlateWidth,
       -cylinderRadius
     ])
  |> close()
  |> extrude(length = ribThickness, symmetric = true)

// Edge ribs at short edges of coefficients plate
edgeRibPadding = 0.1
edgeRibs = startSketchOn(XZ)
  |> startProfile(at = [cylinderCenterX, cylinderCenterZ])
  |> yLine(length = cylinderRadius + edgeRibPadding, tag = $midTriangleBaseToRadius)
  |> line(endAbsolute = [cylinderCenterX - coefficientsPlateWidth, cylinderCenterZ])
  |> line(endAbsolute = [cylinderCenterX + edgeRibPadding, cylinderCenterZ - cylinderRadius - edgeRibPadding])
  |> arc(
       interiorAbsolute = [cylinderCenterX + cylinderRadius + edgeRibPadding, cylinderCenterZ],
       endAbsolute = segEnd(midTriangleBaseToRadius)
     )
  |> close()
  |> extrude(length = ribThickness)
  |> patternLinear3d(axis = [0, 1, 0], instances = 2, distance = coefficientsPlateLength-ribThickness)
  |> translate(x = 0, y = -coefficientsPlateLength/2 + ribThickness, z = 0)

// Summation plate: triangular extension with curved sides using 3-point arcs
summationPlate = startSketchOn(XY)
  |> startProfile(at = [
       cylinderCenterX,
       -summationPlateBaseLength / 2
     ])
  |> line(end = [0, summationPlateBaseLength])
  |> arc(
       interiorAbsolute = [
         cylinderCenterX + summationPlateHeight / 2,
         summationPlateBaseLength / 4 - summationPlateCurvature
       ],
       endAbsolute = [
         cylinderCenterX + summationPlateHeight,
         0
       ],
     )
  |> arc(
       interiorAbsolute = [
         cylinderCenterX + summationPlateHeight / 2,
         -summationPlateBaseLength / 4 + summationPlateCurvature
       ],
       endAbsolute = [
         cylinderCenterX,
         -summationPlateBaseLength / 2
       ],
     )
  |> close()
  |> extrude(length = plateThickness)

// Summation anchor: cylinder at summation plate tip with center hole
summationAnchorRadius = 0.375
summationAnchorHeight = 0.75
summationAnchorHoleRadius = 2 * holeRadius
summationPlateTipX = cylinderCenterX + summationPlateHeight

summationAnchorHole = startSketchOn(XY)
  |> circle(center = [summationPlateTipX, 0], radius = summationAnchorHoleRadius)

summationAnchor = startSketchOn(XY)
  |> circle(center = [summationPlateTipX, 0], radius = summationAnchorRadius)
  |> subtract2d(tool = summationAnchorHole)
  |> extrude(length = summationAnchorHeight, symmetric = true)

// Summing Lever for Harmonic Analyzer
// Material: Cast iron (as seen in reference photo)
// Purpose: First-class lever that sums multiple harmonic inputs from springs
// and transfers the combined motion to the recording mechanism




@settings(defaultLengthUnit = in, kclVersion = 1.0)

// ============================================================================
// INPUT PARAMETERS
// ============================================================================

// Overall dimensions
leverLength = 5.0 // Total horizontal length
baseThickness = 0.125 // 1/8" extrusion thickness
paddleWidth = 3.0 // Width of paddle section


// Margins and spacing
edgeMargin = 0.25 // Distance from edges for hole placement
outputHoleMargin = 0.25 // Distance from right end for output hole
cornerRadius = 0.5 // Radius for rounded corners
leftSetback = 3.0 // Setback on left edge before radius (side with holes)


// Hole specifications
paddleHoleCount = 20 // Number of mounting holes in line
paddleHoleDiam = 0.0403 // Spring mounting hole diameter (18 AWG wire gauge)
outputHoleDiam = 0.0508 // Output hole diameter (16 AWG wire gauge)


// Fulcrum slot (for future use)
fulcrumSlotWidth = 0.5 // Width of mounting slot
fulcrumSlotLength = 1.0 // Length of mounting slot


// Future features (not yet implemented)
// edgeFillet = 0.0625 // 1/16" fillet on main edges
// smallRadius = 0.333 // 1/3" radius for tight curves
// largeRadius = 2.0 // 2" radius for gradual transitions

// ============================================================================
// CALCULATED PARAMETERS
// ============================================================================

// Geometric relationships
paddleLength = leverLength * 0.25 // Paddle takes 25% of lever length
fulcrumPosition = leverLength / 2 // Fulcrum at center
outputHolePosition = leverLength - outputHoleMargin // Output hole near right end


// Paddle hole pattern
paddleHoleSpacingY = (paddleWidth - (2 * edgeMargin)) / (paddleHoleCount - 1)
paddleHoleStartX = edgeMargin // Start holes one margin from left edge
paddleHoleStartY = -paddleWidth / 2 + edgeMargin // Start position across width


// Right arm dimensions (for future use)
counterArmLength = leverLength - fulcrumPosition

// ============================================================================
// ASSERTIONS - Validate design constraints
// ============================================================================


assert(leverLength, isGreaterThan = 2.0, error = "Lever length too short")
assert(paddleWidth, isGreaterThan = 2 * edgeMargin, error = "Paddle width too narrow for margins")
assert(outputHoleMargin, isLessThan = leverLength * 0.4, error = "Output hole margin too large")
assert(paddleHoleSpacingY, isGreaterThan = paddleHoleDiam, error = "Paddle holes too close - will overlap")
assert(cornerRadius, isLessThan = paddleWidth / 2, error = "Corner radius too large for paddle width")
assert(cornerRadius, isLessThan = leverLength / 2, error = "Corner radius too large for lever length")

// ============================================================================
// PHASE 3: LEVER PROFILE WITH ORGANIC CURVES
// ============================================================================

// Create base lever profile with rounded corners and left setback
leverProfile = startSketchOn(XY)
  |> startProfile(at = [0, -paddleWidth / 2])
  |> line(end = [leftSetback, 0]) // Setback on side with holes
  |> line(end = [0, cornerRadius])
  |> tangentialArc(angle = 90, radius = cornerRadius)
  |> line(end = [0, paddleWidth - (2 * cornerRadius)])
  |> tangentialArc(angle = 90, radius = cornerRadius)
  |> line(end = [
       leverLength - leftSetback - (2 * cornerRadius),
       0
     ])
  |> tangentialArc(angle = 90, radius = cornerRadius)
  |> line(end = [0, -(paddleWidth - (2 * cornerRadius))])
  |> tangentialArc(angle = 90, radius = cornerRadius)
  |> line(end = [
       -(leverLength - leftSetback - cornerRadius),
       0
     ])
  |> close()

// Create mounting hole pattern (single line of holes across width on left end)
mountingHoles = startSketchOn(XY)
  |> circle(center = [paddleHoleStartX, paddleHoleStartY], radius = paddleHoleDiam / 2)
  |> patternLinear2d(axis = Y, instances = paddleHoleCount, distance = paddleHoleSpacingY)

// Create output hole on opposite end (centered)
outputHole = startSketchOn(XY)
  |> circle(center = [outputHolePosition, 0], radius = outputHoleDiam / 2)

// Subtract all holes in 2D before extruding (best practice - more reliable than 3D subtract)
leverOutline = leverProfile
  |> subtract2d(tool = mountingHoles)
  |> subtract2d(tool = outputHole)
  |> extrude(length = baseThickness)

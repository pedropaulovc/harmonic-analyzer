// Summing Lever for Harmonic Analyzer
// Material: Cast iron (as seen in reference photo)
// Purpose: First-class lever that sums multiple harmonic inputs from springs
// and transfers the combined motion to the recording mechanism




@settings(defaultLengthUnit = in, kclVersion = 1.0)

// ============================================================================
// INPUT PARAMETERS (from sketch)
// ============================================================================

// Overall dimensions from sketch
leverLength = 10.0 // Total horizontal length
baseThickness = 0.125 // 1/8" extrusion thickness


// Left paddle section (wide end with mounting holes)
paddleWidth = 4.5 // Width at widest point (left end)
paddleLength = 3.0 // Length of paddle section


// Center section (narrow waist)
waistWidth = 2.0 // Narrowest width at center
waistPosition = 5.0 // Distance from left to center of waist
centerHoleDiam = 1.0 // Center fulcrum hole diameter


// Right section (counter-weight with rounded end)
counterWidth = 2.0 // Width of counter arm
counterEndRadius = 1.0 // Radius of rounded right end
counterLength = 3.0 // Length of counter section


// Transition radii
smallRadius = 0.333 // Small transition curves (1/3")


// Hole specifications
paddleHoleCount = 20 // Number of mounting holes in line
paddleHoleDiam = 0.0403 // Spring mounting hole diameter (18 AWG wire gauge)
paddleHoleMargin = 0.25 // Distance from edge for holes
outputHoleDiam = 0.0508 // Output hole diameter (16 AWG wire gauge)


// ============================================================================
// CALCULATED PARAMETERS
// ============================================================================

// Paddle hole pattern (vertical line along left edge)
paddleHoleSpacingY = (paddleWidth - (2 * paddleHoleMargin)) / (paddleHoleCount - 1)
paddleHoleStartX = paddleHoleMargin
paddleHoleStartY = -paddleWidth / 2 + paddleHoleMargin

// Position calculations
outputHolePosition = leverLength - counterEndRadius - 0.5 // Near right end
transitionLength = (waistPosition - paddleLength - counterLength) / 2 // Length of each transition


// ============================================================================
// ASSERTIONS - Validate design constraints
// ============================================================================


assert(leverLength, isGreaterThan = paddleLength + counterLength, error = "Lever too short")
assert(paddleWidth, isGreaterThan = waistWidth, error = "Paddle must be wider than waist")
assert(paddleHoleSpacingY, isGreaterThan = paddleHoleDiam, error = "Paddle holes too close")

// ============================================================================
// GEOMETRY - Top view profile matching sketch
// ============================================================================


// Build the profile in a simple, controlled way:
// 1. Left paddle (wide section with rounded end)
// 2. Taper to narrow waist
// 3. Widen back out to counter section
// 4. Rounded counter end


leverProfile = startSketchOn(XY)
  // Start at bottom-left corner of paddle
  |> startProfile(at = [smallRadius, -paddleWidth / 2])

  // Left rounded end (bottom half)
  |> tangentialArc(angle = -90, radius = smallRadius)
  |> line(end = [0, paddleWidth - (2 * smallRadius)])
  |> tangentialArc(angle = -90, radius = smallRadius)

  // Top edge of paddle
  |> line(end = [paddleLength - (2 * smallRadius), 0])

  // Taper from paddle to waist (top side)
  |> tangentialArc(angle = -45, radius = smallRadius)
  |> line(end = [
       transitionLength,
       -(paddleWidth - waistWidth) / 2
     ])
  |> tangentialArc(angle = -45, radius = smallRadius)

  // Top of waist section
  |> line(end = [
       waistPosition - paddleLength - transitionLength,
       0
     ])

  // Widen from waist to counter (top side)
  |> tangentialArc(angle = 45, radius = smallRadius)
  |> line(end = [
       transitionLength,
       (counterWidth - waistWidth) / 2
     ])
  |> tangentialArc(angle = 45, radius = smallRadius)

  // Top of counter section
  |> line(end = [
       counterLength - counterEndRadius - 0.5,
       0
     ])

  // Rounded right end (semicircle)
  |> tangentialArc(angle = 90, radius = counterEndRadius)
  |> tangentialArc(angle = 90, radius = counterEndRadius)

  // Bottom of counter section
  |> line(end = [
       -(counterLength - counterEndRadius - 0.5),
       0
     ])

  // Narrow from counter to waist (bottom side)
  |> tangentialArc(angle = 45, radius = smallRadius)
  |> line(end = [
       -transitionLength,
       -(counterWidth - waistWidth) / 2
     ])
  |> tangentialArc(angle = 45, radius = smallRadius)

  // Bottom of waist section
  |> line(end = [
       -(waistPosition - paddleLength - transitionLength),
       0
     ])

  // Widen from waist to paddle (bottom side)
  |> tangentialArc(angle = -45, radius = smallRadius)
  |> line(end = [
       -transitionLength,
       (paddleWidth - waistWidth) / 2
     ])
  |> tangentialArc(angle = -45, radius = smallRadius)

  // Bottom edge of paddle
  |> line(end = [-(paddleLength - (2 * smallRadius)), 0])
  |> close()

// Create mounting hole pattern (vertical line on left paddle)
mountingHoles = startSketchOn(XY)
  |> circle(center = [paddleHoleStartX, paddleHoleStartY], radius = paddleHoleDiam / 2)
  |> patternLinear2d(axis = Y, instances = paddleHoleCount, distance = paddleHoleSpacingY)

// Create center fulcrum hole
centerHole = startSketchOn(XY)
  |> circle(center = [waistPosition, 0], radius = centerHoleDiam / 2)

// Create output hole on right end
outputHole = startSketchOn(XY)
  |> circle(center = [outputHolePosition, 0], radius = outputHoleDiam / 2)

// Subtract all holes in 2D before extruding
leverOutline = leverProfile
  |> subtract2d(tool = mountingHoles)
  |> subtract2d(tool = centerHole)
  |> subtract2d(tool = outputHole)
  |> extrude(length = baseThickness)

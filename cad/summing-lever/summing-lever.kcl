// Summing Lever for Harmonic Analyzer
// Material: Cast iron (as seen in reference photo)
// Purpose: First-class lever that sums multiple harmonic inputs from springs
// and transfers the combined motion to the recording mechanism




@settings(defaultLengthUnit = in, kclVersion = 1.0)

// ============================================================================
// INPUT PARAMETERS
// ============================================================================

// Overall dimensions
leverLength = 13.0 // Total length (from sketch)
baseThickness = 0.125 // 1/8" extrusion thickness


// Section widths (from sketch)
paddleWidth = 3.0 // Top paddle section width
middleWidth = 4.0 // Middle section width (widest part)
counterWidth = 2.0 // Bottom counter-weight arm width


// Transition radii (from sketch)
smallRadius = 1.0 / 3.0 // 1/3" radius for tight curves
largeRadius = 2.0 // 2" radius for gradual transitions


// Margins and spacing
edgeMargin = 0.25 // Distance from edges for hole placement


// Hole specifications
paddleHoleCount = 20 // Number of mounting holes in line
paddleHoleDiam = 0.0403 // Spring mounting hole diameter (18 AWG wire gauge)
counterHoleDiam = 1.0 // Counter-weight hole diameter (from sketch)


// Fulcrum slot (for future use)
fulcrumSlotWidth = 0.5 // Width of mounting slot
fulcrumSlotLength = 1.0 // Length of mounting slot


// ============================================================================
// CALCULATED PARAMETERS
// ============================================================================

// Section lengths (from sketch proportions)
paddleLength = 5.0 // Paddle section length
middleLength = 3.0 // Middle section length
fulcrumPosition = 10.0 // Fulcrum position from top (sketch shows ~10")
counterArmLength = leverLength - fulcrumPosition // Remaining length for counter arm


// Hole positions
counterHolePosition = leverLength - 1.0 // Counter hole 1" from end


// Paddle hole pattern
paddleHoleStartX = edgeMargin // Start holes one margin from top edge
paddleHoleStartY = -paddleWidth / 2 + edgeMargin // Start position across width
paddleHoleSpacingY = (paddleWidth - (2 * edgeMargin)) / (paddleHoleCount - 1)

// ============================================================================
// ASSERTIONS - Validate design constraints
// ============================================================================


assert(leverLength, isGreaterThan = 10.0, error = "Lever length too short")
assert(paddleWidth, isGreaterThan = 2 * edgeMargin, error = "Paddle width too narrow for margins")
assert(middleWidth, isGreaterThan = paddleWidth, error = "Middle section should be wider than paddle")
assert(counterWidth, isLessThan = paddleWidth, error = "Counter arm should be narrower than paddle")
assert(paddleHoleSpacingY, isGreaterThan = paddleHoleDiam, error = "Paddle holes too close - will overlap")
assert(fulcrumPosition, isLessThan = leverLength, error = "Fulcrum position beyond lever length")

// ============================================================================
// PHASE 3: LEVER PROFILE WITH ORGANIC TAPERED SHAPE
// ============================================================================

// Create organic tapered lever profile matching sketch
// Starts at 3" wide (paddle), expands to 4" (middle), tapers to 2" (counter arm)
leverProfile = startSketchOn(XY)
  |> startProfile(at = [0, -paddleWidth / 2])
  // Left side: paddle section
  |> line(end = [paddleLength, 0])
  // Transition outward to middle section (3" -> 4")
  |> tangentialArc(angle = 15, radius = largeRadius)
  |> line(end = [middleLength, 0])
  // Transition inward to counter arm (4" -> 2")
  |> tangentialArc(angle = -30, radius = largeRadius)
  |> line(end = [counterArmLength - 1.0, 0])
  // Rounded end
  |> tangentialArc(angle = 90, radius = counterWidth / 2)
  // Right side: counter arm
  |> line(end = [-(counterArmLength - 1.0), 0])
  // Transition outward from counter to middle (2" -> 4")
  |> tangentialArc(angle = -30, radius = largeRadius)
  |> line(end = [-middleLength, 0])
  // Transition inward from middle to paddle (4" -> 3")
  |> tangentialArc(angle = 15, radius = largeRadius)
  |> line(end = [-paddleLength, 0])
  |> close()

// Create mounting hole pattern (single line of holes across width on left end)
mountingHoles = startSketchOn(XY)
  |> circle(center = [paddleHoleStartX, paddleHoleStartY], radius = paddleHoleDiam / 2)
  |> patternLinear2d(axis = Y, instances = paddleHoleCount, distance = paddleHoleSpacingY)

// Create counter-weight hole (1" diameter from sketch)
counterHole = startSketchOn(XY)
  |> circle(center = [counterHolePosition, 0], radius = counterHoleDiam / 2)

// Subtract all holes in 2D before extruding (best practice - more reliable than 3D subtract)
leverOutline = leverProfile
  |> subtract2d(tool = mountingHoles)
  |> subtract2d(tool = counterHole)
  |> extrude(length = baseThickness)

// Harmonic Analyzer Base - Two-plate welded construction

@settings(defaultLengthUnit = in, kclVersion = 1.0)

// Bottom plate parameters
bottomWidth = 11
bottomLength = 18
bottomHeight = 0.5

// Top plate parameters
topWidth = 10.5
topLength = 17.5
topHeight = 1.5

// Fillet radius where plates meet
filletRadius = 0.125

// Edge fillet radius (smooths outer edges)
edgeFilletRadius = 0.0625

// Calculated parameters
totalHeight = bottomHeight + topHeight

// Assertions
assert(topWidth, isLessThan = bottomWidth, error = "Top plate must be narrower than bottom")
assert(topLength, isLessThan = bottomLength, error = "Top plate must be shorter than bottom")

// Bottom plate profile (centered at origin) with rounded corners
bottomPlate = startSketchOn(XY)
  |> startProfile(at = [-bottomLength/2 + edgeFilletRadius, -bottomWidth/2])
  |> line(end = [bottomLength - 2 * edgeFilletRadius, 0], tag = $bottomFront)
  |> tangentialArc(angle = 90deg, radius = edgeFilletRadius)
  |> line(end = [0, bottomWidth - 2 * edgeFilletRadius], tag = $bottomRight)
  |> tangentialArc(angle = 90deg, radius = edgeFilletRadius)
  |> line(end = [-(bottomLength - 2 * edgeFilletRadius), 0], tag = $bottomBack)
  |> tangentialArc(angle = 90deg, radius = edgeFilletRadius)
  |> line(end = [0, -(bottomWidth - 2 * edgeFilletRadius)], tag = $bottomLeft)
  |> tangentialArc(angle = 90deg, radius = edgeFilletRadius)
  |> close()
  |> extrude(length = bottomHeight, tagEnd = $bottomTop)

// Top plate profile (sketch on top of bottom plate) with rounded corners
topPlate = startSketchOn(bottomPlate, face = END)
  |> startProfile(at = [-topLength/2 + edgeFilletRadius, -topWidth/2])
  |> line(end = [topLength - 2 * edgeFilletRadius, 0], tag = $topFront)
  |> tangentialArc(angle = 90deg, radius = edgeFilletRadius)
  |> line(end = [0, topWidth - 2 * edgeFilletRadius], tag = $topRight)
  |> tangentialArc(angle = 90deg, radius = edgeFilletRadius)
  |> line(end = [-(topLength - 2 * edgeFilletRadius), 0], tag = $topBack)
  |> tangentialArc(angle = 90deg, radius = edgeFilletRadius)
  |> line(end = [0, -(topWidth - 2 * edgeFilletRadius)], tag = $topLeft)
  |> tangentialArc(angle = 90deg, radius = edgeFilletRadius)
  |> close()
  |> extrude(length = topHeight, tagEnd = $topTop)

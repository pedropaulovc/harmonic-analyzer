// Combined Tangential Arc Profile
// Two-piece profile with concave arcs at upper-left and lower-left corners

@settings(defaultLengthUnit = mm, kclVersion = 1.0)

// Input parameters
totalWidth = 360
totalHeight = 400
extrusionDepth = 10

// Create the combined 2D profile
profile = startSketchOn(XY)
  |> startProfile(at = [0, 0])
  // Top edge with upper arc (concave)
  |> line(end = [95, 0])
  |> tangentialArc(end = [50, 50])
  |> line(end = [215, 0])
  // Right edge
  |> line(end = [0, 150])
  |> line(end = [0, 150])
  // Back along top of lower section
  |> line(end = [-215, 0])
  // Lower arc (concave)
  |> tangentialArc(end = [50, 50])
  // Bottom edge
  |> line(end = [-145, 0])
  // Left edge back to start
  |> close()
  |> extrude(length = extrusionDepth)

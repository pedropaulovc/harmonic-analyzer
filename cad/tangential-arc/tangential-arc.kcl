// Tangential Arc Profile
// Purpose: 2D profile demonstrating tangentialArc with a concave rounded corner

@settings(defaultLengthUnit = mm, kclVersion = 1.0)

// Input parameters
totalWidth = 350
totalHeight = 150
leftMargin = 25
bottomMargin = 25

// Concave corner parameters
cornerStartX = 95  // Distance from left edge where corner starts
cornerEndX = 145   // Distance from left edge where corner ends
cornerDepth = 50   // How deep the concave curve goes

// 3D parameters
extrudeHeight = 10  // Thickness of the extruded solid

// Calculated parameters
rightEdgeX = leftMargin + totalWidth
topEdgeY = bottomMargin + totalHeight
cornerAbsStartX = leftMargin + cornerStartX
cornerAbsEndX = leftMargin + cornerEndX
cornerBottomY = bottomMargin + totalHeight - cornerDepth

// Create the profile with tangential arc and extrude to 3D
solid = startSketchOn(XY)
  |> startProfile(at = [leftMargin, bottomMargin])
  |> line(end = [0, totalHeight])  // Left edge going up
  |> line(end = [cornerStartX, 0])  // Top edge to corner start
  |> tangentialArc(end = [cornerEndX - cornerStartX, -cornerDepth])  // Concave arc
  |> line(end = [totalWidth - cornerEndX, 0])  // Top right edge
  |> line(end = [0, -(totalHeight - cornerDepth)])  // Right edge going down
  |> close()  // Bottom edge back to start
  |> extrude(length = extrudeHeight)

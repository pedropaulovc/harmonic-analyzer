// Tangential Arc Profile
// Purpose: Demonstrate tangentialArc feature with concave rounded corner

// Settings
@settings(defaultLengthUnit = mm, kclVersion = 1.0)

// Input parameters
baseWidth = 360
baseHeight = 200
arcStartX = 95
arcEndX = 145
arcY = 50

// Create base profile with tangential arc
profile = startSketchOn(XY)
  |> startProfile(at = [25, 25])
  |> line(end = [arcStartX, 0])
  |> tangentialArc(end = [arcEndX - arcStartX, -arcY])
  |> line(end = [baseWidth - arcEndX, 0])
  |> line(end = [0, baseHeight])
  |> line(end = [-baseWidth, 0])
  |> close()

// Tangential Arc Profile
// Purpose: Demonstrate tangentialArc feature with symmetric concave rounded corners

// Settings
@settings(defaultLengthUnit = mm, kclVersion = 1.0)

// Input parameters
totalWidth = 360
totalHeight = 200
arcWidth = 50
arcDepth = 50

// Calculated parameters
halfWidth = totalWidth / 2
halfHeight = totalHeight / 2

// Create symmetric profile with tangential arcs on both sides
profile = startSketchOn(XY)
  |> startProfile(at = [-halfWidth, -halfHeight])
  |> line(end = [0, totalHeight])
  |> line(end = [halfWidth - arcWidth, 0])
  |> tangentialArc(end = [arcWidth, -arcDepth])
  |> tangentialArc(end = [arcWidth, arcDepth])
  |> line(end = [halfWidth - arcWidth, 0])
  |> line(end = [0, -totalHeight])
  |> line(end = [-halfWidth + arcWidth, 0])
  |> tangentialArc(end = [-arcWidth, arcDepth])
  |> tangentialArc(end = [-arcWidth, -arcDepth])
  |> close()

// Tangential Arc Profile - Two-level stepped profile with concave arc transition

@settings(defaultLengthUnit = mm, kclVersion = 1.0)

// Input parameters
leftWidth = 100
leftHeight = 100
rightWidth = 290
rightHeight = 150
arcRadius = 30

// Calculated parameters
totalWidth = leftWidth + rightWidth
stepHeight = rightHeight - leftHeight

// Create the profile
profile = startSketchOn(XY)
  |> startProfile(at = [0, 0])
  |> line(end = [leftWidth, 0], tag = $bottom)
  |> line(end = [0, leftHeight], tag = $leftRise)
  |> tangentialArc(angle = -90deg, radius = arcRadius, tag = $topArc)
  |> line(end = [rightWidth, 0], tag = $topRun)
  |> line(end = [0, -rightHeight], tag = $rightDrop)
  |> close(tag = $baseLine)

// Extrude to create 3D solid
solid = extrude(profile, length = 10)

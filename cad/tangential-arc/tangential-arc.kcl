// Tangential Arc Profile
// Purpose: Demonstrate tangentialArc feature with concave rounded corner

// Settings
@settings(defaultLengthUnit = mm, kclVersion = 1.0)

// Input parameters
baseWidth = 360
baseHeight = 200
arcStartX = 95
arcWidth = 50
arcDepth = 50

// Create base profile with tangential arc in upper-left corner
profile = startSketchOn(XY)
  |> startProfile(at = [0, 0])
  |> line(end = [arcStartX, 0])
  |> tangentialArc(end = [arcWidth, arcDepth])
  |> line(end = [baseWidth - arcStartX - arcWidth, 0])
  |> line(end = [0, baseHeight])
  |> line(end = [-baseWidth, 0])
  |> close()

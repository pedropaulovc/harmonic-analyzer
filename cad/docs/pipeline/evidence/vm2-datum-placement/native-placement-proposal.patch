+    callout_below: str = "",
+    placement: Literal["requested", "native"] = "requested",
+    native_z_axis_radius_m: float | None = None,
+) -> Any:
+    """Attach a native datum-feature symbol to a drawing-view edge.
+
+    ``entity_type`` widens the pick for entities that are not model edges —
+    a revolve's flank lines are ``"SILHOUETTE"`` edges.
+
+    ``native`` explicitly opts an entity-selected origin-Z cylinder into
+    SolidWorks-chosen placement. The unchanged ``position_tolerance_m`` bounds
+    XY movement across rebuild, not distance from a requested sheet point.
+    Print clearance and cold-reopen acceptance still need the lifecycle gate.
+    """
+    if placement not in {"requested", "native"}:
+        raise ValueError(f"unknown datum placement: {placement!r}")
+    if placement == "requested" and symbol_xy is None:
+        raise ValueError(f"{label}: requested placement requires symbol_xy")
+    if placement == "requested" and native_z_axis_radius_m is not None:
+        raise ValueError(f"{label}: native Z-axis radius requires native placement")
+    if placement == "native":
+        if (
+            entity is None or entity_type != "EDGE"
+            or any(value is not None for value in (
+                edge_xy, edge_entity, annotation, symbol_xy,
+            ))
+        ):
+            raise ValueError(
+                f"{label}: native placement requires only an explicit EDGE entity"
+            )
+        if not math.isfinite(position_tolerance_m) or position_tolerance_m <= 0.0:
+            raise ValueError(f"{label}: native tolerance must be finite and positive")
+        if (
+            native_z_axis_radius_m is None
+            or not math.isfinite(native_z_axis_radius_m)
+            or native_z_axis_radius_m <= 0.0
+        ):
+            raise ValueError(f"{label}: native radius must be finite and positive")
+        _validate_native_datum_z_axis_edge(
+            entity, radius_m=native_z_axis_radius_m, label=label
+        )
+    draw = adapter.currentModel
+    if annotation is None:
+        selected_entity = _select_annotation_entity(
+            adapter,
+            view,
+            edge_xy=edge_xy,
+            edge_entity=edge_entity,
+            entity=entity,
+            entity_type=entity_type,
+            label=label,
+        )
+        if (
+            placement == "native"
+            and int(adapter.swApp.IsSame(selected_entity, entity)) != 1
+        ):
+            raise RuntimeError(f"{label}: drawing selected a different datum edge")
     else:

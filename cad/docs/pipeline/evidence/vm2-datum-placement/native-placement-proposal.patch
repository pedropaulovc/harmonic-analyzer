+def test_native_axis_datum_keeps_limit_and_separates_bore_dimension() -> None:
+    source = Path(drawing.__file__).read_text(encoding="utf-8")
+    datum_a = source[source.index("add_datum_feature(") :]
+    datum_a = datum_a[: datum_a.index("    )")]
+    assert "entity=bore_edge" in datum_a
+    assert 'placement="native"' in datum_a
+    assert "native_z_axis_radius_m=BORE_DIA / 2000.0" in datum_a
+    assert "position_tolerance_m=0.0001" in datum_a
+    assert "shoulder=True" in datum_a
+    assert "edge_xy=" not in datum_a
+    assert "symbol_xy=" not in datum_a
+    assert drawing.FRONT_KEEP["BoreDia"] == (
+        drawing.FRONT_CENTER[0] - 0.062,
+        drawing.FRONT_CENTER[1] + 0.038,
+    )
+    assert drawing.DIMENSION_PRECISION == {"BoreDia": 2}
+

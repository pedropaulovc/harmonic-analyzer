// Eccentric Cam - produces harmonic motion for follower
// Simple cylinder with off-center mounting hole
// Displacement = eccentricity × sin(θ)

@settings(defaultLengthUnit = in, kclVersion = 1.0)

import camDiameter, camThickness, shaftDiameter, keywayWidth, keywayDepth from "parameters.kcl"

// Input parameters - cam geometry
eccentricity = 0.2     // Offset distance from center (amplitude of motion)

// Calculated parameters
camRadius = camDiameter / 2
minClearance = camRadius - eccentricity - shaftDiameter / 2

// Assertions
assert(camDiameter, isGreaterThan = shaftDiameter, error = "Cam diameter must be larger than shaft")
assert(eccentricity, isGreaterThan = 0, isLessThan = camRadius, error = "Eccentricity must be less than cam radius")
assert(minClearance, isGreaterThan = 0, error = "Shaft hole too close to cam edge")
assert(camThickness, isGreaterThan = 0, error = "Cam thickness must be positive")
assert(keywayWidth, isLessThan = shaftDiameter, error = "Keyway too wide for shaft")

// Create circular cam body (centered at origin)
camBody = startSketchOn(XY)
  |> circle(center = [0, 0], radius = camRadius)

// Create shaft hole with keyway
// The hole is positioned at [eccentricity, 0] to create eccentric motion
shaftRadius = shaftDiameter / 2
startAngle = asin(keywayWidth / 2 / shaftRadius)

holeWithKeyway = startSketchOn(XY)
  |> startProfile(at = [
       eccentricity + shaftRadius * cos(startAngle),
       shaftRadius * sin(startAngle)
     ])
  |> xLine(length = keywayDepth)
  |> yLine(length = -keywayWidth)
  |> xLine(length = -keywayDepth)
  |> arc(
       angleStart = -1 * startAngle + 360deg,
       angleEnd = 180deg,
       radius = shaftRadius
     )
  |> arc(
       angleStart = 180deg,
       angleEnd = startAngle,
       radius = shaftRadius
     )
  |> close()

// Combine: subtract hole (with keyway) from cam body, then extrude
cam = camBody
  |> subtract2d(tool = holeWithKeyway)
  |> extrude(length = camThickness, tagEnd = $topFace)

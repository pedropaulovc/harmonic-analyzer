{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getpad.dev/cmdhelp.schema.json",
  "title": "cmdhelp v0.1",
  "description": "JSON Schema for output of `<cmd> help --format json` per the cmdhelp v0.1 spec.",
  "type": "object",
  "required": ["cmdhelp_version", "binary", "commands"],
  "additionalProperties": true,
  "properties": {
    "cmdhelp_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "binary": {
      "type": "string",
      "minLength": 1
    },
    "version": { "type": "string" },
    "summary": { "type": "string" },
    "homepage": { "type": "string", "format": "uri" },
    "global_flags": { "$ref": "#/$defs/flagMap" },
    "commands": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/command" },
      "minProperties": 0
    },
    "schemas": {
      "type": "object",
      "additionalProperties": true
    },
    "context": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "workspace": { "type": "string" },
        "profile": { "type": "string" },
        "auth": { "type": "string" }
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "required": ["summary"],
      "additionalProperties": true,
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "args": {
          "type": "array",
          "items": { "$ref": "#/$defs/arg" }
        },
        "flags": { "$ref": "#/$defs/flagMap" },
        "stdin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accepted": { "type": "boolean" },
            "format": { "type": "string" }
          },
          "required": ["accepted"]
        },
        "stdout": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "text_template": { "type": "string" },
            "json_schema_ref": { "type": "string" }
          }
        },
        "exit_codes": {
          "type": "object",
          "patternProperties": {
            "^[0-9]+$": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                { "$ref": "#/$defs/exitCodeRich" }
              ]
            }
          },
          "additionalProperties": false
        },
        "examples": {
          "type": "array",
          "items": { "$ref": "#/$defs/example" }
        },
        "see_also": {
          "type": "array",
          "items": { "type": "string" }
        },
        "since": { "type": "string" },
        "stability": { "type": "string" }
      }
    },
    "arg": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/typeName" },
        "required": { "type": "boolean" },
        "description": { "type": "string" },
        "default": {},
        "format": { "type": "string" },
        "repeatable": { "type": "boolean" },
        "enum": { "$ref": "#/$defs/enumValues" },
        "enum_source": { "$ref": "#/$defs/enumSource" }
      },
      "allOf": [{ "$ref": "#/$defs/enumConsistency" }]
    },
    "flagMap": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
      },
      "additionalProperties": { "$ref": "#/$defs/flag" }
    },
    "flag": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": true,
      "properties": {
        "type": { "$ref": "#/$defs/typeName" },
        "required": { "type": "boolean" },
        "description": { "type": "string" },
        "default": {},
        "format": { "type": "string" },
        "repeatable": { "type": "boolean" },
        "enum": { "$ref": "#/$defs/enumValues" },
        "enum_source": { "$ref": "#/$defs/enumSource" },
        "negate_flag": {
          "type": "string",
          "pattern": "^--[a-zA-Z0-9][a-zA-Z0-9-]*$"
        }
      },
      "allOf": [
        { "$ref": "#/$defs/enumConsistency" },
        {
          "if": { "required": ["negate_flag"] },
          "then": { "properties": { "type": { "const": "bool" } } }
        }
      ]
    },
    "typeName": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "string", "int", "float", "bool", "enum",
            "path", "url", "duration", "date", "datetime", "json", "ref"
          ]
        },
        {
          "type": "string",
          "pattern": "^x-[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        }
      ]
    },
    "enumValues": {
      "type": "array",
      "items": { "type": ["string", "number", "boolean"] },
      "minItems": 0
    },
    "enumSource": {
      "type": "string",
      "pattern": "^dynamic:.+$"
    },
    "enumConsistency": {
      "if": {
        "anyOf": [
          { "required": ["enum"] },
          { "required": ["enum_source"] }
        ]
      },
      "then": {
        "properties": { "type": { "type": "string" } }
      }
    },
    "exitCodeRich": {
      "type": "object",
      "required": ["when"],
      "additionalProperties": true,
      "properties": {
        "when": { "type": "string", "minLength": 1 },
        "recovery": { "type": "string" },
        "message_template": { "type": "string" }
      }
    },
    "example": {
      "type": "object",
      "required": ["cmd"],
      "additionalProperties": true,
      "properties": {
        "cmd": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      }
    }
  }
}

// Amplitude Bar - Vertical rod with notches at top and bottom




@settings(defaultLengthUnit = in, kclVersion = 1.0)

// Input parameters
barLength = 8
barWidth = 0.25
barDepth = 0.25

// Bottom notch
bottomNotchWidth = 0.125
bottomNotchHeight = 0.09375 // 3/32"


// Top notch
topNotchWidth = 0.125
topNotchHeight = 0.5

// Calculated parameters
notchDepth = barWidth / 2 // Notch cuts halfway into the bar


// Single sketch profile with notches included
barProfile = startSketchOn(XZ)
  |> startProfile(at = [bottomNotchWidth, 0])
  // Bottom edge to right
  |> line(end = [barWidth - bottomNotchWidth, 0])
  // Right edge going up
  |> line(end = [0, barLength])
  // Top edge going left
  |> line(end = [-(barWidth - bottomNotchWidth), 0])
  // Down to bottom of top notch
  |> line(end = [0, -topNotchHeight])
  // Left out of top notch
  |> line(end = [-bottomNotchWidth, 0])
  // Down outside left edge
  |> line(end = [0, -(barLength - topNotchHeight - bottomNotchHeight)])
  // Right into bottom notch
  |> line(end = [bottomNotchWidth, 0])
  // Down to close
  |> close()
  |> extrude(length = barDepth)

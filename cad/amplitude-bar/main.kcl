// Amplitude Bar - Vertical rod with notches at top and bottom




@settings(defaultLengthUnit = in, kclVersion = 1.0)

// Input parameters
barLength = 32
barWidth = 0.25
barDepth = 0.25

// Bottom notch
bottomNotchWidth = 0.125
bottomNotchHeight = 0.09375 // 3/32"


// Top notch
topNotchWidth = 0.125
topNotchHeight = 0.5

// Calculated parameters
leftNotchOffset = (barWidth - bottomNotchWidth) / 2
rightNotchOffset = (barWidth - topNotchWidth) / 2

// Single sketch profile tracing around both centered notches
barProfile = startSketchOn(XZ)
  |> startProfile(at = [0, 0])
  // Bottom edge to left side of bottom notch
  |> line(end = [leftNotchOffset, 0])
  // Up into bottom notch
  |> line(end = [0, bottomNotchHeight])
  // Right across bottom notch
  |> line(end = [bottomNotchWidth, 0])
  // Down out of bottom notch
  |> line(end = [0, -bottomNotchHeight])
  // Right to right edge
  |> line(end = [leftNotchOffset, 0])
  // Up right edge to top
  |> line(end = [0, barLength])
  // Left to right side of top notch
  |> line(end = [-rightNotchOffset, 0])
  // Down into top notch
  |> line(end = [0, -topNotchHeight])
  // Left across top notch
  |> line(end = [-topNotchWidth, 0])
  // Up out of top notch
  |> line(end = [0, topNotchHeight])
  // Left to left edge
  |> line(end = [-rightNotchOffset, 0])
  // Down left edge to close
  |> close()
  |> extrude(length = barDepth)

// Amplitude Bar - Vertical rod with notches at top and bottom




@settings(defaultLengthUnit = in, kclVersion = 1.0)

// Input parameters
barLength = 8
barWidth = 0.25
barDepth = 0.25

// Bottom notch
bottomNotchWidth = 0.125
bottomNotchHeight = 0.09375 // 3/32"


// Top notch
topNotchWidth = 0.125
topNotchHeight = 0.5

// Calculated parameters
notchDepth = barWidth / 2 // Notch cuts halfway into the bar


// Main bar profile
mainProfile = startSketchOn(XZ)
  |> startProfile(at = [0, 0])
  |> line(end = [barWidth, 0])
  |> line(end = [0, barLength])
  |> line(end = [-barWidth, 0])
  |> close()

// Bottom notch profile (centered)
bottomNotchProfile = startSketchOn(XZ)
  |> startProfile(at = [(barWidth - bottomNotchWidth) / 2, 0])
  |> line(end = [bottomNotchWidth, 0])
  |> line(end = [0, bottomNotchHeight])
  |> line(end = [-bottomNotchWidth, 0])
  |> close()

// Top notch profile (centered)
topNotchProfile = startSketchOn(XZ)
  |> startProfile(at = [(barWidth - topNotchWidth) / 2, barLength - topNotchHeight])
  |> line(end = [topNotchWidth, 0])
  |> line(end = [0, topNotchHeight])
  |> line(end = [-topNotchWidth, 0])
  |> close()

// Combine: subtract notches from main bar, then extrude
barProfile = mainProfile
  |> subtract2d(tool = bottomNotchProfile)
  |> subtract2d(tool = topNotchProfile)
  |> extrude(length = barDepth)

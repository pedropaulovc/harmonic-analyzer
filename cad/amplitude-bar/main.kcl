// Amplitude Bar - Vertical rod with notches at top and bottom

@settings(defaultLengthUnit = in, kclVersion = 1.0)

// Input parameters
barLength = 32
barWidth = 0.25
barDepth = 0.25

// Bottom notch
bottomNotchWidth = 0.125
bottomNotchHeight = 0.09375  // 3/32"

// Top notch
topNotchWidth = 0.125
topNotchHeight = 0.5

// Calculated parameters
notchDepth = barWidth / 2  // Notch cuts halfway into the bar

// Main bar profile (square cross-section)
barProfile = startSketchOn(XY)
  |> startProfile(at = [-barWidth/2, -barDepth/2])
  |> line(end = [barWidth, 0], tag = $front)
  |> line(end = [0, barDepth], tag = $right)
  |> line(end = [-barWidth, 0], tag = $back)
  |> close(tag = $left)
  |> extrude(length = barLength, tagStart = $bottom, tagEnd = $top)

// Bottom notch - cut into the side of the bar near the bottom
bottomNotch = startSketchOn(barProfile, face = front)
  |> startProfile(at = [-barDepth/2, 0])
  |> line(end = [barDepth, 0])
  |> line(end = [0, bottomNotchHeight])
  |> line(end = [-barDepth, 0])
  |> close()
  |> extrude(length = -notchDepth)

// Top notch - cut into the side of the bar near the top
topNotch = startSketchOn(barProfile, face = front)
  |> startProfile(at = [-barDepth/2, barLength - topNotchHeight])
  |> line(end = [barDepth, 0])
  |> line(end = [0, topNotchHeight])
  |> line(end = [-barDepth, 0])
  |> close()
  |> extrude(length = -notchDepth)

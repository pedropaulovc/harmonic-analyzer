// Sheet Metal Console Bracket - C-Shaped Design
// Material: 20 gauge sheet metal (0.0359" thick)
// Purpose: Wall-mounted console bracket with ventilation and mounting capabilities

// Set units
@settings(defaultLengthUnit = in, kclVersion = 1.0)

// Input parameters
sheetThickness = 0.0359
width = 10.0
topLength = 5.0
verticalLength = 10.0
bottomLength = 3.0
bendRadius = 0.125

// Mounting holes (for #8 screws)
mountHoleDia = 0.177
mountHoleOffset = 1.0 // offset from edges


// Ventilation slots
ventSlotWidth = 1.0
ventSlotHeight = 2.5
ventSlotCount = 4

// Calculated parameters
extBendRadius = bendRadius + sheetThickness
slotSpacing = (width - (ventSlotCount * ventSlotWidth)) / (ventSlotCount + 1)
slotZ = -verticalLength / 2 // Center vertically


// Add assertions to ensure valid geometry
assert(topLength, isGreaterThanOrEqual = mountHoleDia * 3, error = "topLength too small for mounting holes")
assert(width, isGreaterThanOrEqual = mountHoleDia * 3, error = "width too small for mounting holes")
assert(mountHoleOffset, isGreaterThan = mountHoleDia / 2, error = "mountHoleOffset too small")
assert(slotSpacing, isGreaterThan = 0, error = "Too many vent slots for bracket width")

// Create C-shaped profile (side view in XZ plane)
// Starting from top-left corner, creating the outer path
cProfile = startSketchOn(XZ)
  |> startProfile(at = [0, 0])
  |> line(end = [topLength, 0], tag = $topOuter) // Top section - extends right
  |> tangentialArc(angle = -90deg, radius = bendRadius) // First bend - curves down
  |> line(end = [0, -verticalLength], tag = $verticalOuter) // Vertical section - goes down
  |> tangentialArc(angle = -90deg, radius = bendRadius) // Second bend - curves LEFT for C-shape
  |> line(end = [-bottomLength, 0], tag = $bottomOuter) // Bottom section - extends LEFT
  |> line(end = [0, sheetThickness]) // Thickness at edge
  |> line(end = [bottomLength, 0]) // Bottom inner - back right
  |> tangentialArc(angle = 90deg, radius = bendRadius - sheetThickness) // Inner bend
  |> line(end = [0, verticalLength], tag = $verticalInner) // Vertical inner - up
  |> tangentialArc(angle = 90deg, radius = bendRadius - sheetThickness) // Inner bend
  |> line(end = [-topLength, 0]) // Top inner - back left
  |> close()
  |> extrude(length = width)

  // Create mounting holes pattern on top face
// 4 holes in rectangular pattern (2x2 grid)
mountingHoles = startSketchOn(cProfile, face = topOuter)
  |> circle(center = [-mountHoleOffset, mountHoleOffset], radius = mountHoleDia / 2)
  |> patternLinear2d(instances = 2, distance = width - (mountHoleOffset * 2), axis = [0, 1])
  |> patternLinear2d(instances = 2, distance = -(topLength - (mountHoleOffset * 2)), axis = [1, 0])
  |> extrude(length = -sheetThickness)

  // Create ventilation slots pattern on vertical face
// Evenly spaced slots along the width
ventSlots = startSketchOn(cProfile, face = verticalOuter)
  |> startProfile(at = [
       slotZ - (ventSlotHeight / 2),
       slotSpacing
     ])
  |> line(end = [ventSlotHeight, 0])
  |> line(end = [0, ventSlotWidth])
  |> line(end = [-ventSlotHeight, 0])
  |> close()
  |> patternLinear2d(instances = ventSlotCount, distance = slotSpacing + ventSlotWidth, axis = [0, 1])
  |> extrude(length = -sheetThickness)

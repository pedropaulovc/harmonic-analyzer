// Serif Capital T Letter - Classic serif typography




@settings(defaultLengthUnit = in, kclVersion = 1.0)

// Input parameters
letterHeight = 10
stemWidth = 1.5
crossbarThickness = 1.5
crossbarWidth = 7
serifLength = 0.6
serifThickness = 0.4
extrudeDepth = 0.5
filletRadius = 0.15

// Calculated parameters
stemHeight = letterHeight - crossbarThickness
crossbarOverhang = (crossbarWidth - stemWidth) / 2
serifOverhang = (stemWidth + serifLength * 2 - stemWidth) / 2

// Assertions
assert(letterHeight, isGreaterThan = 0, error = "Height must be positive")
assert(crossbarWidth, isGreaterThan = stemWidth, error = "Crossbar must be wider than stem")
assert(serifLength, isGreaterThan = 0, error = "Serif length must be positive")

// Create the T profile with rounded corners - starting from bottom left
tProfile = startSketchOn(XY)
  // Bottom left serif
  |> startProfile(at = [-serifOverhang, 0])
  |> line(end = [
       serifLength + stemWidth + serifLength,
       0
     ])
  |> line(end = [0, serifThickness - filletRadius])
  |> tangentialArc(angle = 90deg, radius = filletRadius)
  |> line(end = [-serifLength + 0, 0])
  |> tangentialArc(angle = -90deg, radius = filletRadius)
  // Right side of stem
  |> line(end = [0, stemHeight - serifThickness - 0])
  // Bottom right of crossbar (inner corner)
  |> tangentialArc(angle = -90deg, radius = filletRadius)
  |> line(end = [crossbarOverhang - 0, 0])
  |> tangentialArc(angle = 90deg, radius = filletRadius)
  |> line(end = [0, crossbarThickness - filletRadius])
  |> tangentialArc(angle = 90deg, radius = filletRadius)
  // Top of crossbar
  |> line(end = [-crossbarWidth + 0, 0])
  // Left side going down
  |> tangentialArc(angle = 90deg, radius = filletRadius)
  |> line(end = [0, -crossbarThickness + filletRadius])
  |> tangentialArc(angle = 90deg, radius = filletRadius)
  |> line(end = [crossbarOverhang - 0, 0])
  // Bottom left of crossbar (inner corner)
  |> tangentialArc(angle = -90deg, radius = filletRadius)
  // Left side of stem
  |> line(end = [0, -(stemHeight - serifThickness - 0)])
  |> arc(angleStart = 90, angleEnd = 180, radius = filletRadius)
  // Top left serif
  |> line(end = [-serifLength + 0, 0])
  // |> tangentialArc(angle = 90deg, radius = filletRadius)
  |> line(end = [0, -serifThickness + filletRadius])
  // |> close()

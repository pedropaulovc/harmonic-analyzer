// Sheet Metal Console Bracket - C-Shaped Design
// Material: 20 gauge sheet metal (0.0359" thick)
// Dimensions: 10" width × 18" total flat length (before bending)

// Parameters
sheetThickness = 0.0359
width = 10.0
topLength = 5.0
verticalLength = 10.0
bottomLength = 3.0
bendRadius = 0.125

// Mounting holes (for #8 screws)
mountHoleDia = 0.177
mountHoleOffset = 1.0 // offset from edges


// Ventilation slots
ventSlotWidth = 1.0
ventSlotHeight = 2.5

// Create C-shaped profile (side view in XZ plane)
// Starting from top-left corner, creating the outer path
cProfile = startSketchOn(XZ)
  |> startProfile(at = [0, 0])
  |> line(end = [topLength, 0], tag = $topOuter) // Top section - extends right
  |> tangentialArc(angle = -90deg, radius = bendRadius) // First bend - curves down
  |> line(end = [0, -verticalLength], tag = $verticalOuter) // Vertical section - goes down
  |> tangentialArc(angle = 90deg, radius = bendRadius) // Second bend - curves LEFT for C-shape
  |> line(end = [-bottomLength, 0], tag = $bottomOuter) // Bottom section - extends LEFT
  |> line(end = [0, -sheetThickness]) // Thickness at edge
  |> line(end = [bottomLength, 0]) // Bottom inner - back right
  |> tangentialArc(angle = -90deg, radius = bendRadius - sheetThickness) // Inner bend
  |> line(end = [0, verticalLength], tag = $verticalInner) // Vertical inner - up
  |> tangentialArc(angle = 90deg, radius = bendRadius - sheetThickness) // Inner bend
  |> line(end = [-topLength, 0]) // Top inner - back left
  |> close()
  |> extrude(length = width)

  // Add mounting holes on the top face
// Create 4 holes in a rectangular pattern
mountHole1 = startSketchOn(cProfile, face = topOuter)
  |> circle(
       center = [
         mountHoleOffset,
         width - mountHoleOffset
       ],
       radius = mountHoleDia / 2,
     )

mountHole2 = startSketchOn(cProfile, face = topOuter)
  |> circle(
       center = [
         topLength - mountHoleOffset,
         width - mountHoleOffset
       ],
       radius = mountHoleDia / 2,
     )

mountHole3 = startSketchOn(cProfile, face = topOuter)
  |> circle(center = [mountHoleOffset, mountHoleOffset], radius = mountHoleDia / 2)

mountHole4 = startSketchOn(cProfile, face = topOuter)
  |> circle(
       center = [
         topLength - mountHoleOffset,
         mountHoleOffset
       ],
       radius = mountHoleDia / 2,
     )

// Create mounting holes
hole1 = extrude(mountHole1, length = -sheetThickness)
hole2 = extrude(mountHole2, length = -sheetThickness)
hole3 = extrude(mountHole3, length = -sheetThickness)
hole4 = extrude(mountHole4, length = -sheetThickness)

// Add ventilation slots on the vertical face
// 4 slots evenly spaced
slotSpacing = (width - (4 * ventSlotWidth)) / 5
slot1Y = slotSpacing
slot2Y = slotSpacing * 2 + ventSlotWidth
slot3Y = slotSpacing * 3 + ventSlotWidth * 2
slot4Y = slotSpacing * 4 + ventSlotWidth * 3

slotZ = -verticalLength / 2 // Center vertically


ventSlot1 = startSketchOn(cProfile, face = verticalOuter)
  |> startProfile(at = [slotZ - (ventSlotHeight / 2), slot1Y])
  |> line(end = [ventSlotHeight, 0])
  |> line(end = [0, ventSlotWidth])
  |> line(end = [-ventSlotHeight, 0])
  |> close()
  |> extrude(length = -sheetThickness)

ventSlot2 = startSketchOn(cProfile, face = verticalOuter)
  |> startProfile(at = [slotZ - (ventSlotHeight / 2), slot2Y])
  |> line(end = [ventSlotHeight, 0])
  |> line(end = [0, ventSlotWidth])
  |> line(end = [-ventSlotHeight, 0])
  |> close()
  |> extrude(length = -sheetThickness)

ventSlot3 = startSketchOn(cProfile, face = verticalOuter)
  |> startProfile(at = [slotZ - (ventSlotHeight / 2), slot3Y])
  |> line(end = [ventSlotHeight, 0])
  |> line(end = [0, ventSlotWidth])
  |> line(end = [-ventSlotHeight, 0])
  |> close()
  |> extrude(length = -sheetThickness)

ventSlot4 = startSketchOn(cProfile, face = verticalOuter)
  |> startProfile(at = [slotZ - (ventSlotHeight / 2), slot4Y])
  |> line(end = [ventSlotHeight, 0])
  |> line(end = [0, ventSlotWidth])
  |> line(end = [-ventSlotHeight, 0])
  |> close()
  |> extrude(length = -sheetThickness)

// Sheet Metal Console Bracket - C-Shaped Design
// Material: 20 gauge 304 stainless steel (0.0359" thick)
// Yield strength: ~40,000 psi typical for 304 SS
// Application: Wall-mounted equipment console support
// Design: C-shaped bent sheet metal profile for wall mounting

// Set units
@settings(defaultLengthUnit = in, kclVersion = 1.0)

// Material and Design Parameters
sheetThickness = 0.0359 // 20 gauge
width = 10.0
topLength = 5.0 // Horizontal mounting surface
verticalLength = 10.0 // Vertical drop
bottomLength = 3.0 // Bottom support ledge
bendRadius = 0.125 // Inner bend radius


// Mounting holes (for #8 screws, 0.164" nominal diameter)
mountHoleDia = 0.177 // Clearance hole for #8 screw
mountHoleOffset = 1.0 // Offset from edges


// Ventilation slots
ventSlotWidth = 1.0
ventSlotHeight = 2.5
numVentSlots = 4

// Edge finishing
cornerFilletRadius = 0.03125 // 1/32" radius for safe handling


// Calculated parameters
extBendRadius = bendRadius + sheetThickness // Outer bend radius
totalFlatLength = topLength + verticalLength + bottomLength + PI * bendRadius // Approximate developed length
slotSpacing = (width - (numVentSlots * ventSlotWidth)) / (numVentSlots + 1)
slotCenterZ = -verticalLength / 2 // Center slots vertically on face


// Design validation - ensure holes fit within geometry
assert(topLength, isGreaterThanOrEqual = mountHoleDia * 4, error = "topLength too short for mounting hole pattern. Increase topLength or decrease mountHoleDia")
assert(width, isGreaterThanOrEqual = mountHoleDia * 3, error = "width too narrow for mounting hole pattern. Increase width or decrease mountHoleDia")
assert(width, isGreaterThanOrEqual = numVentSlots * ventSlotWidth + (numVentSlots + 1) * 0.5, error = "width too narrow for ventilation slots. Increase width, decrease ventSlotWidth, or reduce numVentSlots")
assert(verticalLength, isGreaterThanOrEqual = ventSlotHeight + 1.0, error = "verticalLength too short for ventilation slots. Increase verticalLength or decrease ventSlotHeight")

// Create C-shaped profile (side view in XZ plane)
// Starting from top-left corner, creating the outer path
cProfile = startSketchOn(XZ)
  |> startProfile(at = [0, 0])
  |> line(end = [topLength, 0], tag = $topOuter) // Top section - extends right
  |> tangentialArc(angle = -90deg, radius = bendRadius) // First bend - curves down
  |> line(end = [0, -verticalLength], tag = $verticalOuter) // Vertical section - goes down
  |> tangentialArc(angle = -90deg, radius = bendRadius) // Second bend - curves LEFT for C-shape
  |> line(end = [-bottomLength, 0], tag = $bottomOuter) // Bottom section - extends LEFT
  |> line(end = [0, sheetThickness]) // Thickness at edge
  |> line(end = [bottomLength, 0]) // Bottom inner - back right
  |> tangentialArc(angle = 90deg, radius = bendRadius - sheetThickness) // Inner bend
  |> line(end = [0, verticalLength], tag = $verticalInner) // Vertical inner - up
  |> tangentialArc(angle = 90deg, radius = bendRadius - sheetThickness) // Inner bend
  |> line(end = [-topLength, 0]) // Top inner - back left
  |> close()
  |> extrude(length = width)

// Add mounting holes on the top face using pattern operations
mountingHoles = startSketchOn(cProfile, face = topOuter)
  |> circle(center = [mountHoleOffset, mountHoleOffset], radius = mountHoleDia / 2)
  |> patternLinear2d(instances = 2, distance = topLength - (2 * mountHoleOffset), axis = [1, 0])
  |> patternLinear2d(instances = 2, distance = width - (2 * mountHoleOffset), axis = [0, 1])
  |> extrude(length = -sheetThickness - 0.01)

// Add ventilation slots on the vertical face using pattern operations
ventSlots = startSketchOn(cProfile, face = verticalOuter)
  |> startProfile(at = [
       slotCenterZ - (ventSlotHeight / 2),
       slotSpacing
     ])
  |> line(end = [ventSlotHeight, 0])
  |> line(end = [0, ventSlotWidth])
  |> line(end = [-ventSlotHeight, 0])
  |> close()
  |> patternLinear2d(instances = numVentSlots, distance = slotSpacing + ventSlotWidth, axis = [0, 1])
  |> extrude(length = -sheetThickness - 0.01)

// Apply corner fillets for safe handling and professional appearance
fillet(
  cProfile,
  radius = cornerFilletRadius,
  tags = [
    getNextAdjacentEdge(topOuter),
    getOppositeEdge(getNextAdjacentEdge(topOuter)),
    getNextAdjacentEdge(bottomOuter),
    getOppositeEdge(getNextAdjacentEdge(bottomOuter))
  ],
)

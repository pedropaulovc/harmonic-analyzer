// Console Bracket - Sheet Metal C-Shape
// Single continuous sketch design
// 20 gauge sheet metal (0.0359" thick)

// Material and dimensions
sheetThickness = 3mm  // 20 gauge sheet metal
width = 200mm  // 10 inches
topShelfDepth = 100mm  // 5 inches
verticalHeight = 200mm  // 10 inches
bottomShelfDepth = 80mm  // 3 inches

// Screw hole specifications (#8 clearance)
screwHoleDia = 5mm
edgeClearance = 10mm

// Create entire C-shape profile in a single continuous sketch
bracketProfile = startSketchOn(XZ)
  |> startProfile(at = [0, 0])
  // Bottom shelf - moving right
  |> line(end = [width, 0])
  |> line(end = [0, -bottomShelfDepth])
  |> line(end = [-width + sheetThickness, 0])
  // Vertical back section - moving up
  |> line(end = [0, bottomShelfDepth])
  |> line(end = [0, verticalHeight])
  // Top shelf - moving right
  |> line(end = [width - sheetThickness, 0])
  |> line(end = [0, topShelfDepth])
  |> line(end = [-width, 0])
  |> line(end = [0, -topShelfDepth])
  // Complete the loop back down
  |> line(end = [0, -verticalHeight])
  |> close()

// Add 4 ventilation slots in the vertical section
ventSlot1 = startSketchOn(XZ)
  |> rectangle(width = 60mm, height = 25mm, center = [width/4, verticalHeight * 0.4])

ventSlot2 = startSketchOn(XZ)
  |> rectangle(width = 60mm, height = 25mm, center = [3*width/4, verticalHeight * 0.4])

ventSlot3 = startSketchOn(XZ)
  |> rectangle(width = 60mm, height = 25mm, center = [width/4, verticalHeight * 0.6])

ventSlot4 = startSketchOn(XZ)
  |> rectangle(width = 60mm, height = 25mm, center = [3*width/4, verticalHeight * 0.6])

// Add 4 screw holes in the top shelf
screwHole1 = startSketchOn(XZ)
  |> circle(center = [edgeClearance, verticalHeight + edgeClearance], radius = screwHoleDia/2)

screwHole2 = startSketchOn(XZ)
  |> circle(center = [width - edgeClearance, verticalHeight + edgeClearance], radius = screwHoleDia/2)

screwHole3 = startSketchOn(XZ)
  |> circle(center = [edgeClearance, verticalHeight + topShelfDepth - edgeClearance], radius = screwHoleDia/2)

screwHole4 = startSketchOn(XZ)
  |> circle(center = [width - edgeClearance, verticalHeight + topShelfDepth - edgeClearance], radius = screwHoleDia/2)

// Combine profile with holes and extrude
bracket = bracketProfile
  |> subtract2d(tool = [ventSlot1, ventSlot2, ventSlot3, ventSlot4, screwHole1, screwHole2, screwHole3, screwHole4])
  |> extrude(length = sheetThickness)
  |> appearance(color = "#2C2C2C", metalness = 90, roughness = 90)

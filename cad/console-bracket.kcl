// Console Bracket - C-shaped sheet metal bracket
// Material: 20 gauge sheet metal (0.0359" thick)
// Dimensions: 10" width, 18" total length (before bending)
// Simplified version for rendering (holes and slots not included due to engine limitations)

// Parameters
sheetThickness = 0.0359
bracketWidth = 10
topSectionLength = 5
verticalSectionLength = 10
bottomSectionLength = 3
bendRadius = 0.125

// Create the C-shaped bracket in three separate sections
// Top section (horizontal, for desk mounting)
topSection = startSketchOn(XY)
  |> rectangle(width = bracketWidth, height = topSectionLength, center = [bracketWidth / 2, topSectionLength / 2])
  |> extrude(length = sheetThickness)

// Vertical section (goes down from wall)
verticalOffsetZ = -(topSectionLength + bendRadius)
verticalSection = startSketchOn(XZ)
  |> rectangle(
       width = bracketWidth,
       height = verticalSectionLength,
       center = [
         bracketWidth / 2,
         verticalOffsetZ - (verticalSectionLength / 2)
       ],
     )
  |> extrude(length = sheetThickness)
  |> translate(x = bendRadius + sheetThickness, y = 0, z = 0)

// Bottom section (horizontal shelf)
bottomOffsetZ = verticalOffsetZ - verticalSectionLength - bendRadius
bottomSection = startSketchOn(XY)
  |> rectangle(
       width = bracketWidth,
       height = bottomSectionLength,
       center = [
         bracketWidth / 2,
         bottomSectionLength / 2
       ],
     )
  |> extrude(length = sheetThickness)
  |> translate(x = bendRadius + sheetThickness, y = 0, z = bottomOffsetZ)

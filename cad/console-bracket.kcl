// Console Bracket - Sheet Metal C-Shape
// 20 gauge sheet metal (0.0359" thick)
// 10" width × 18" total length (C-shaped)

// Material and dimensions
sheetThickness = 0.0359in
width = 10in
topLength = 5in
verticalLength = 10in
bottomLength = 3in
bendRadius = 0.125in

// Screw hole specifications (#8 clearance)
screwHoleDia = 0.177in
screwHoleInset = 0.5in

// Ventilation slot specifications
slotWidth = 2.5in
slotHeight = 1.0in
slotSpacing = 1.5in

// Top section (desk mounting) with 4 screw holes
topSection = startSketchOn(XY)
  |> startProfile(at = [0, 0])
  |> line(end = [width, 0])
  |> line(end = [0, topLength])
  |> line(end = [-width, 0])
  |> close()

// Add screw holes to top section
screwHole1 = startSketchOn(XY)
  |> circle(center = [screwHoleInset, screwHoleInset], radius = screwHoleDia / 2)

screwHole2 = startSketchOn(XY)
  |> circle(center = [width - screwHoleInset, screwHoleInset], radius = screwHoleDia / 2)

screwHole3 = startSketchOn(XY)
  |> circle(center = [screwHoleInset, topLength - screwHoleInset], radius = screwHoleDia / 2)

screwHole4 = startSketchOn(XY)
  |> circle(center = [width - screwHoleInset, topLength - screwHoleInset], radius = screwHoleDia / 2)

topWithHoles = topSection
  |> subtract2d(tool = [screwHole1, screwHole2, screwHole3, screwHole4])
  |> extrude(length = sheetThickness)

// Vertical section with ventilation slots
verticalOffset = topLength + bendRadius
verticalSection = startSketchOn(offsetPlane(XY, offset = verticalOffset))
  |> startProfile(at = [0, 0])
  |> line(end = [width, 0])
  |> line(end = [0, sheetThickness])
  |> line(end = [-width, 0])
  |> close()

// Create ventilation slots
slot1Pos = 2.0in
slot2Pos = slot1Pos + slotHeight + slotSpacing

ventSlot1 = startSketchOn(offsetPlane(XY, offset = verticalOffset))
  |> rectangle(width = slotWidth, height = slotHeight, center = [width / 4, slot1Pos])

ventSlot2 = startSketchOn(offsetPlane(XY, offset = verticalOffset))
  |> rectangle(width = slotWidth, height = slotHeight, center = [3 * width / 4, slot1Pos])

ventSlot3 = startSketchOn(offsetPlane(XY, offset = verticalOffset))
  |> rectangle(width = slotWidth, height = slotHeight, center = [width / 4, slot2Pos])

ventSlot4 = startSketchOn(offsetPlane(XY, offset = verticalOffset))
  |> rectangle(width = slotWidth, height = slotHeight, center = [3 * width / 4, slot2Pos])

verticalWithSlots = verticalSection
  |> subtract2d(tool = [ventSlot1, ventSlot2, ventSlot3, ventSlot4])
  |> extrude(length = verticalLength)

// Bottom section (console support shelf)
bottomOffset = verticalOffset + verticalLength + bendRadius
bottomSection = startSketchOn(offsetPlane(XY, offset = bottomOffset))
  |> startProfile(at = [0, 0])
  |> line(end = [width, 0])
  |> line(end = [0, bottomLength])
  |> line(end = [-width, 0])
  |> close()
  |> extrude(length = sheetThickness)

// Combine all sections
bracket = union([topWithHoles, verticalWithSlots, bottomSection])
  |> appearance(color = "#404040", metalness = 80, roughness = 20)

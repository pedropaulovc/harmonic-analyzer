// Console Bracket - Sheet Metal C-Shape
// 20 gauge sheet metal (0.0359" thick)
// 10" width × 18" total length (C-shaped)

// Material and dimensions
sheetThickness = 3mm  // 20 gauge sheet metal
width = 200mm  // 10 inches
topShelfDepth = 100mm  // 5 inches
verticalHeight = 200mm  // 10 inches
bottomShelfDepth = 80mm  // 3 inches

// Screw hole specifications (#8 clearance)
screwHoleDia = 5mm
edgeClearance = 10mm

// Create the vertical back section with ventilation holes
verticalBack = startSketchOn(XZ)
  |> startProfile(at = [0, 0])
  |> line(end = [width, 0], tag = $bottomEdge)
  |> line(end = [0, verticalHeight], tag = $rightEdge)
  |> line(end = [-width, 0], tag = $topEdge)
  |> line(end = [0, -verticalHeight], tag = $leftEdge)
  |> close()

// Add 4 ventilation slots
ventHole1 = startSketchOn(XZ)
  |> rectangle(width = 60mm, height = 25mm, center = [width/4, verticalHeight * 0.4])

ventHole2 = startSketchOn(XZ)
  |> rectangle(width = 60mm, height = 25mm, center = [3*width/4, verticalHeight * 0.4])

ventHole3 = startSketchOn(XZ)
  |> rectangle(width = 60mm, height = 25mm, center = [width/4, verticalHeight * 0.6])

ventHole4 = startSketchOn(XZ)
  |> rectangle(width = 60mm, height = 25mm, center = [3*width/4, verticalHeight * 0.6])

// Create main vertical section with holes
bracket = verticalBack
  |> subtract2d(tool = [ventHole1, ventHole2, ventHole3, ventHole4])
  |> extrude(length = sheetThickness)

// Add top mounting shelf (sketching on top edge of vertical)
topShelf = startSketchOn(bracket, face = topEdge)
  |> startProfile(at = [0, sheetThickness])
  |> line(end = [width, 0])
  |> line(end = [0, topShelfDepth])
  |> line(end = [-width, 0])
  |> close()

// Add screw holes to top shelf
screwHole1 = startSketchOn(bracket, face = topEdge)
  |> circle(center = [edgeClearance, sheetThickness + edgeClearance], radius = screwHoleDia/2)

screwHole2 = startSketchOn(bracket, face = topEdge)
  |> circle(center = [width - edgeClearance, sheetThickness + edgeClearance], radius = screwHoleDia/2)

screwHole3 = startSketchOn(bracket, face = topEdge)
  |> circle(center = [edgeClearance, sheetThickness + topShelfDepth - edgeClearance], radius = screwHoleDia/2)

screwHole4 = startSketchOn(bracket, face = topEdge)
  |> circle(center = [width - edgeClearance, sheetThickness + topShelfDepth - edgeClearance], radius = screwHoleDia/2)

topShelfWithHoles = topShelf
  |> subtract2d(tool = [screwHole1, screwHole2, screwHole3, screwHole4])
  |> extrude(length = sheetThickness, method = NEW)

// Add bottom support shelf (sketching on bottom edge of vertical)
bottomShelf = startSketchOn(bracket, face = bottomEdge)
  |> startProfile(at = [0, -sheetThickness])
  |> line(end = [width, 0])
  |> line(end = [0, -bottomShelfDepth])
  |> line(end = [-width, 0])
  |> close()
  |> extrude(length = sheetThickness, method = NEW)

// Apply appearance to all parts
bracket
  |> appearance(color = "#2C2C2C", metalness = 90, roughness = 90)

topShelfWithHoles
  |> appearance(color = "#2C2C2C", metalness = 90, roughness = 90)

bottomShelf
  |> appearance(color = "#2C2C2C", metalness = 90, roughness = 90)

// Harmonic Analyzer Base - Two-plate welded construction

@settings(defaultLengthUnit = in, kclVersion = 1.0)

// Bottom plate parameters
// bottomWidth = 11
// bottomLength = 18
// bottomHeight = 0.5

// Debug only
bottomWidth = 15
bottomLength = 25
bottomHeight = 0.5

// Top plate parameters
topWidth = 10.5
topLength = 17.5
topHeight = 1.5

// Fillet radius where plates meet
filletRadius = 0.125

// Edge fillet radius (smooths outer edges)
edgeFilletRadius = 0.0625

// Calculated parameters
totalHeight = bottomHeight + topHeight

// Assertions
assert(topWidth, isLessThan = bottomWidth, error = "Top plate must be narrower than bottom")
assert(topLength, isLessThan = bottomLength, error = "Top plate must be shorter than bottom")

// Bottom plate profile (centered at origin) with rounded corners
bottomPlate = startSketchOn(XY)
  |> startProfile(at = [-bottomLength/2, -bottomWidth/2])
  |> line(end = [bottomLength, 0], tag = $bottomFront)
  |> line(end = [0, bottomWidth], tag = $bottomRight)
  |> line(end = [-bottomLength, 0], tag = $bottomBack)
  |> close(tag = $bottomLeft)
  |> extrude(length = bottomHeight, tagEnd = $bottomTop)
  |> fillet(
      radius = filletRadius,
      tags = [
        // Bottom fillets, bottom plate
        bottomFront,
        bottomRight,
        bottomLeft,
        bottomBack,
        
        // Side fillets, bottom plate
        getNextAdjacentEdge(bottomFront),
        getNextAdjacentEdge(bottomRight),
        getNextAdjacentEdge(bottomLeft),
        getNextAdjacentEdge(bottomBack),
        
        // Top fillets, bottom plate
        getCommonEdge(faces = [bottomFront, bottomTop]),
        getCommonEdge(faces = [bottomRight, bottomTop]),
        getCommonEdge(faces = [bottomLeft, bottomTop]),
        getCommonEdge(faces = [bottomBack, bottomTop]),
      ])

// Top plate profile (sketch on top of bottom plate)
topPlate = startSketchOn(bottomPlate, face = END)
  |> startProfile(at = [-topLength/2, -topWidth/2])
  |> line(end = [topLength, 0], tag = $topFront)
  |> line(end = [0, topWidth], tag = $topRight)
  |> line(end = [-topLength, 0], tag = $topBack)
  |> close(tag = $topLeft)
  |> extrude(length = topHeight, tagEnd = $topTop)
  |> fillet(
       radius = edgeFilletRadius,
       tags = [
         // Intersection fillets between both plates
         getCommonEdge(faces = [topFront, bottomTop]),
         getCommonEdge(faces = [topRight, bottomTop]),
         getCommonEdge(faces = [topBack, bottomTop]),
         getCommonEdge(faces = [topLeft, bottomTop]),
        
         // Side fillets, top plate
         // getNextAdjacentEdge(topFront),
         // getNextAdjacentEdge(topRight),
         // getNextAdjacentEdge(topBack),
         // getNextAdjacentEdge(topLeft),

         // Top fillets, top plate
         // getCommonEdge(faces = [topFront, topTop]),
         // getCommonEdge(faces = [topRight, topTop]),
         // getCommonEdge(faces = [topBack, topTop]),
         // getCommonEdge(faces = [topLeft, topTop])
       ]
     )



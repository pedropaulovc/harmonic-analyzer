// Rocker Arm Support - Trapezoidal bracket with center cutout and pivot pin

@settings(defaultLengthUnit = mm, kclVersion = 1.0)

// Base dimensions
baseLength = 120
baseWidth = 40
baseThickness = 8

// Support dimensions
supportHeight = 100
supportBottomWidth = 40
supportTopWidth = 20
supportThickness = 30

// Cutout dimensions
cutoutWidth = 24
cutoutHeight = 60
cutoutBottomOffset = 20

// Top pivot pin
pinDiameter = 12
pinHeight = 15

// Mounting holes
mountHoleDia = 6
mountHoleSpacing = 80

// Fillet radius
filletRadius = 2

// Calculated angle for trapezoid
sideOffset = (supportBottomWidth - supportTopWidth) / 2

// Base plate with mounting holes
basePlate = startSketchOn(XY)
  |> startProfile(at = [-baseLength/2, -baseWidth/2])
  |> line(end = [baseLength, 0], tag = $baseFront)
  |> line(end = [0, baseWidth], tag = $baseRight)
  |> line(end = [-baseLength, 0], tag = $baseBack)
  |> close(tag = $baseLeft)

mountingHoles = startSketchOn(XY)
  |> circle(center = [-mountHoleSpacing/2, 0], radius = mountHoleDia/2)
  |> circle(center = [mountHoleSpacing/2, 0], radius = mountHoleDia/2)

// Build complete part
base = basePlate
  |> subtract2d(tool = mountingHoles)
  |> extrude(length = baseThickness, tagEnd = $baseTop)

// Vertical trapezoidal support - sketch on base top
support = base
  |> startSketchOn(face = END)
  |> startProfile(at = [-supportThickness/2, -supportBottomWidth/2])
  |> line(end = [0, supportBottomWidth])
  |> line(end = [sideOffset, supportHeight])
  |> line(end = [0, -supportTopWidth])
  |> close()
  |> extrude(length = supportThickness, tagEnd = $supportTop)

// Cut window through support using negative extrude from front face
cutoutPlane = {
  origin = [-supportThickness/2 - 0.5, 0, baseThickness + cutoutBottomOffset],
  xAxis = [0, 1, 0],
  yAxis = [0, 0, 1],
  zAxis = [1, 0, 0]
}
supportWithCutout = support
  |> startSketchOn(cutoutPlane)
  |> startProfile(at = [-cutoutWidth/2, 0])
  |> line(end = [cutoutWidth, 0])
  |> line(end = [0, cutoutHeight])
  |> line(end = [-cutoutWidth, 0])
  |> close()
  |> extrude(length = -(supportThickness + 1))

// Top pivot pin
part = supportWithCutout
  |> startSketchOn(offsetPlane(XY, offset = baseThickness + supportHeight))
  |> circle(center = [0, 0], radius = pinDiameter/2)
  |> extrude(length = pinHeight)

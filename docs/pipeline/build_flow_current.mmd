flowchart TD
    subgraph SRC["① Source of Truth (git-tracked)"]
        BS["build_*.py part scripts<br/>build_*_assembly.py"]
        HELP["_common.py · _config.py<br/>_gear.py · _chain.py<br/>_nameplate_geometry.py"]
        CFG["cad/config/*.yaml<br/>machine · channels · dimensions<br/>parts · tolerances · materials"]
    end

    subgraph ENV["② Environment"]
        SW["SolidWorks 3DEXPERIENCE R2026x<br/>(running, STA COM seat)"]
        VENV[".venv python + doit + pillow"]
        MCP["SolidworksMCP-python<br/>PyWin32Adapter (COM bridge)"]
    end

    DOIT{{"③ dodo.py — doit entrypoint<br/>serial only, content-hash DAG<br/>(cad/out/.doit.db)"}}
    SRC --> DOIT
    ENV --> DOIT
    MCP -.COM calls.-> SW

    DOIT --> GRAPH["④ _buildgraph.py<br/>discover parts → build DAG<br/>part → assembly order"]

    GRAPH --> PART["⑤ task_part — per stem<br/>create sketch → constrain →<br/>ensure_fully_defined → features →<br/>material → mass props"]
    PART --> PG1{Sketch fully-defined?<br/>Features rebuild?}
    PG1 -->|fail| FAIL1["✗ RuntimeError<br/>no .SLDPRT"]
    PG1 -->|pass| PARTOUT["⑤ task_part"]
    PARTOUT -.->|ASSETS| APART[("cad/out/sldprt/&lt;stem&gt;.SLDPRT<br/>cad/out/png/&lt;stem&gt;/*.png (6 views)")]

    PARTOUT --> ASMDEC{"⑥ Assembly task<br/>recipe changed OR<br/>target missing?"}
    ASMDEC -->|yes — FULL| FULL["place_component ×N →<br/>mates (coincident/distance/<br/>angle/lock) → per-config<br/>ForceRebuild3 (~500s)"]
    ASMDEC -->|no — REFRESH| REFRESH["reopen → per-config<br/>ForceRebuild3 → Save3<br/>(seconds)"]

    FULL --> AG{DOF resolved?<br/>Model healthy?<br/>Zero interference?}
    REFRESH --> AG
    AG -->|fail| FAIL2["✗ exit non-zero<br/>.SLDASM untouched"]
    AG -->|pass| ASMOUT["⑥ assembly<br/>frame→drive_train→channel→summing→<br/>magnifier→pen→paper_drive→harmonic_analyzer (TOP)"]
    ASMOUT -.->|ASSETS| AASM[("cad/out/sldasm/&lt;stem&gt;.SLDASM<br/>cad/out/png/&lt;stem&gt;/*.png (6 views)")]

    ASMOUT --> VERIFY["⑦ verify.py --suite all<br/>static · truth · config ·<br/>isolation · motion"]
    VERIFY --> VG{Gates: DOF · healthy ·<br/>interference · gear ratios ·<br/>BOM · pen-trace ±0.01mm}
    VG -->|fail| FAILV["✗ report failures"]
    VG -->|pass| EXPORT["⑧ export_models.py<br/>neutral-format export"]
    EXPORT -.->|ASSETS| AEXP[("cad/out/step/*.STEP (AP214)<br/>cad/out/stl/*.STL (mm, per-config)<br/>cad/out/stl/colors.json<br/>cad/out/boxes/&lt;asm&gt;.json")]

    EXPORT --> COMMIT["⑨ git commit + push<br/>(lint/test first)"]

    COMMIT --> REL["⑩ cut_release.py<br/>[vX.Y.Z | --bump patch/minor/major]"]
    REL --> PRE{"Preflight:<br/>tag free · tree clean ·<br/>TOP .SLDASM built ·<br/>boxes fresh + unit=mm"}
    PRE -->|fail| FAILR["✗ SystemExit"]

    PRE -->|pass| PNG["⑩a Pack-and-Go +<br/>re-export STEP/STL/PNG<br/>into stage/"]
    PNG -.->|ASSETS| APNG[("stage/solidworks/ (flattened P&amp;G)<br/>stage/step/ · stage/stl/<br/>stage/png/ · stage/boxes/")]

    PNG --> DIFF["⑩b render_diff.py (uv run)<br/>download prev release →<br/>offscreen render changed parts<br/>(Hausdorff, noise-filtered)"]
    DIFF -->|no prior / render fails| SKIP["⚠ non-fatal: skip<br/>release continues"]
    DIFF -->|ok| ADIFF[("stage/diff/*.png<br/>stage/diff/diff_summary.json")]
    SKIP --> BUNDLE
    ADIFF --> BUNDLE

    BUNDLE["⑩c make_archive"]
    BUNDLE -.->|ASSET| ABUN[("cad/out/release/<br/>harmonic-analyzer-&lt;ver&gt;.zip<br/>= solidworks + step + stl +<br/>boxes + png + diff")]

    ABUN --> TAG["⑩d git tag -a vX.Y.Z<br/>git push origin vX.Y.Z"]
    TAG --> GH["🚀 ⑩e gh release create vX.Y.Z"]
    GH -.->|ASSETS| AGH[("GitHub Release vX.Y.Z<br/>bundle.zip + diff PNGs<br/>notes: commit SHA · SW rev ·<br/>inventory · changed-parts gallery")]

    classDef gate fill:#fff3cd,stroke:#d39e00,color:#000;
    classDef fail fill:#f8d7da,stroke:#c00,color:#000;
    classDef step fill:#e2e3ff,stroke:#5a5ad8,color:#000;
    classDef asset fill:#d4edda,stroke:#28a745,color:#000;
    classDef rel fill:#cce5ff,stroke:#004085,color:#000;
    class PG1,AG,VG,PRE,ASMDEC gate;
    class FAIL1,FAIL2,FAILV,FAILR fail;
    class SKIP gate;
    class APART,AASM,AEXP,APNG,ADIFF,ABUN,AGH asset;
    class REL,TAG,GH,BUNDLE,PNG,DIFF rel;
